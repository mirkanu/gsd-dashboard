# gsd-dashboard on Zo Computer — environment template
#
# Copy this file to the data dir as `.env` and fill in the blanks. The
# Zo host runs the server with `dotenv` loading on boot; the data dir is
# the one you pass via `GSD_DATA_DIR` (see deploy/zo/README.md).
#
# Required
# --------

# Login password (used to mint the gsd_token cookie). Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DASHBOARD_PASS=

# Absolute path to the data directory. The dashboard will create
#   <GSD_DATA_DIR>/uploads/    uploaded artefacts
#   <GSD_DATA_DIR>/data/       SQLite (dashboard.db)
#   <GSD_DATA_DIR>/gsd-projects.json
# and keep all mutable state here. The repo clone stays clean.
GSD_DATA_DIR=/home/workspace/.gsd-dashboard

# Hostname for the Telegram bot (used in approval links). Optional —
# only set this if you wire the Telegram reply poller later.
# HOSTNAME=gsd-dashboard-mirkanu.zo.computer

# Modes
# -----

# Enables Zo-specific runtime checks (refuses to start without tmux +
# node-pty, forces AUTH_REQUIRED, trusts the Zo reverse proxy, switches
# cookies to Secure + SameSite=Lax).
GSD_ZO_MODE=1

# Inherits AUTH_REQUIRED=1 from the Zo-mode bootstrap, but listed here
# for clarity so an operator can see it in one place.
AUTH_REQUIRED=1

# The dashboard will refuse to start in Zo mode with GSD_DATA_URL set
# (proxy mode is for the Railway path; on Zo the host owns the data).
# Do not set it.

# Optional: legacy secrets (only needed if you ever proxy through a
# second Zo host — not the case for the standard private-site setup).
# GSD_INTERNAL_SECRET=
